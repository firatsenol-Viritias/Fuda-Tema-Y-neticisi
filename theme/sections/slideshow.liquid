

{% if section.blocks.size > 1 %}
  {% if section.settings.display_mode == 'full_frame' %}
    {% assign autoplay = section.settings.autoplay %}
  {% else %}
    {% assign autoplay = false %}
  {% endif %}
  {% capture controls %}
    {%- render 'slideshow-controls',
      style: section.settings.slideshow_controls_style,
      autoplay: autoplay,
      item_count: section.blocks.size,
      show_arrows: false,
      arrows_on_media: true,
      controls_on_media: true,
      pagination_position: 'center',
      icon_style: section.settings.icons_style
    -%}
  {% endcapture %}
{% endif %}

{% capture slides %}
  {% content_for 'blocks' %}
{% endcapture %}

{% liquid
  assign section_width_class = ''
  if section.settings.display_mode == 'with_hints'
    assign section_width_class = 'section--page-width'
    if section.settings.full_frame_on_mobile
      assign section_width_class = section_width_class | append: ' section--mobile-full-width'
    endif
  else
    assign section_width_class = 'section--' | append: section.settings.section_width
  endif

  assign slideshow_class = 'slideshow--content-' | append: section.settings.content_position
  if section.blocks.size == 1
    assign slideshow_class = slideshow_class | append: ' slideshow--single-media'
  endif
  if section.settings.display_mode == 'with_hints'
    assign slideshow_class = slideshow_class | append: ' slideshow--with-hints'
    if section.settings.full_frame_on_mobile
      assign slideshow_class = slideshow_class | append: ' slideshow--with-hints--mobile-full-frame'
    else
      assign slideshow_class = slideshow_class | append: ' slideshow--with-hints--mobile-with-hints'
    endif
  endif

  assign show_arrows = true
  if section.settings.icons_style == 'none' or section.blocks.size <= 1
    assign show_arrows = false
  endif

  assign rounded_slide_corners = false
  if section.settings.display_mode == 'full_frame' and section.settings.section_width == 'page-width'
    assign rounded_slide_corners = true
  elsif section.settings.display_mode == 'with_hints' and section.settings.full_frame_on_mobile == false
    assign rounded_slide_corners = true
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="slideshow-section spacing-style section {{ section_width_class }} color-{{ section.settings.color_scheme }} disable-section-top-offset{% if section.settings.disable_slide_fade %} slideshow-section--no-fade{% endif %}{% if section.settings.fit_to_viewport %} slideshow-section--fit{% endif %}"
  style="{% render 'spacing-padding', settings: section.settings %}; --slideshow-gap: {{ section.settings.slideshow_gap }}px;{% if rounded_slide_corners %} --corner-radius: {{ section.settings.corner_radius }}px;{% endif %}"
>
  <h2 class="visually-hidden">{{ 'accessibility.slideshow' | t }}</h2>
  {% render 'slideshow',
    class: slideshow_class,
    controls: controls,
    show_arrows: show_arrows,
    icon_style: section.settings.icons_style,
    icon_shape: section.settings.icons_shape,
    autoplay: autoplay,
    autoplay_speed: section.settings.autoplay_speed,
    slides: slides,
    slide_count: section.blocks.size,
    slide_size: section.settings.slide_height
  %}
</div>

{%- comment -%}
  Saat basi banner dondurme.

  Slaytlari ilk boyamadan ONCE DOM'da donduruyoruz; boylece secilen slayt
  zaten 0. sirada oluyor. Alternatif olan initial-slide ozniteligi ise
  bileseni once 0. slayti gosterip sonra atlamaya zorluyor (slideshow.js
  bunu requestAnimationFrame icinde yapiyor) ve hero'da goz kirpma olusuyor.

  Bu script satir ici ve klasik; slideshow.js ise type="module", yani
  ertelenmis. Dolayisiyla bilesen yukseltilmeden once calisir.
{%- endcomment -%}

{%- if section.settings.hourly_rotation and section.blocks.size > 1 -%}
  <script>
    (() => {
      // Tema editorunde slayt sirasi degismesin, duzenleme kafa karistirmasin.
      if (window.Shopify && window.Shopify.designMode) return;

      const root = document.getElementById('shopify-section-{{ section.id }}');
      const component = root && root.querySelector('slideshow-component');
      const track = component && component.querySelector('slideshow-slides');
      if (!track) return;

      const slides = Array.from(track.children).filter((el) => el.tagName === 'SLIDESHOW-SLIDE');
      if (slides.length < 2) return;

      // Epoch saati: her ziyaretci ayni saatte ayni banner'i gorur ve
      // gun uzunlugu slayt sayisina bolunmedigi icin gun donumunde
      // atlama olmaz. Sinirlar tam saat basinda (UTC+3'te de tam saat).
      const hour = Math.floor(Date.now() / 3600000);

      // Ozel sira verilmisse (orn. "1,3,2") yalnizca o slaytlar basa gecer.
      // Gecersiz veya kapsam disi numaralar atilir; hicbiri gecerli degilse
      // varsayilan davranisa dusulur.
      const raw = {{ section.settings.rotation_order | default: '' | json }};
      const order = String(raw)
        .split(',')
        .map((n) => parseInt(n.trim(), 10))
        .filter((n) => Number.isInteger(n) && n >= 1 && n <= slides.length)
        .map((n) => n - 1);

      let rotated;
      if (order.length > 0) {
        // Kampanya slaytlari kendi sabit konumlarinda kalir; yalnizca hangi
        // slaydin hangi konuma dustugu saat basi kayar. Boylece kampanya
        // banner'lari birbirinin yanina dusmez, aralarindaki diger slaytlar
        // korunur. Listedeki ilk konum her saat farkli bir banner gosterir.
        const slots = [...new Set(order)].sort((a, b) => a - b);
        const lead = ((hour % order.length) + order.length) % order.length;
        rotated = slides.slice();
        slots.forEach((slot, k) => {
          rotated[slot] = slides[order[(lead + k) % order.length]];
        });
        // Dizilim degismediyse DOM'a dokunma.
        if (rotated.every((el, i) => el === slides[i])) return;
      } else {
        // Sira verilmemisse tum slaytlar saat basi bir kayar.
        const start = ((hour % slides.length) + slides.length) % slides.length;
        if (start === 0) return;
        rotated = slides.slice(start).concat(slides.slice(0, start));
      }

      for (const slide of rotated) track.appendChild(slide);

      // Indekse bagli olan her sey yeni siraya gore yeniden yazilir:
      // kaydirma zaman cizelgesi, erisilebilirlik bayragi ve tiklama hedefi.
      rotated.forEach((slide, index) => {
        slide.style.setProperty('--slideshow-timeline', `--slide-${index}`);
        slide.setAttribute('aria-hidden', index === 0 ? 'false' : 'true');
        if (slide.hasAttribute('on:click')) slide.setAttribute('on:click', `/select/${index}`);
      });
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  /* Slayt gecisinde soldurma efektini kapatir.

     Tema varsayilaninda .slide__content opacity:0 ile baslar ve kaydirmaya
     bagli slide-reveal animasyonuyla acilir. Gecis ortasinda slayt yari
     saydam kaldigi icin arkasindaki bolum arka plani ve komsu slayt
     gorunur. Metin-uzeri-fotograf slaytlarinda efekt gibi duruyor, tam
     ekran banner'larda hata gibi duruyor.

     Ozgulluk .slide__content (0,1,0) uzerinde oldugu icin sira farketmeksizin
     kazanir. */
  .slideshow-section--no-fade .slide__content {
    opacity: 1;
    animation: none;
  }

  /* Banner'in tamami ekrana sigsin.

     Slaytlar 16:9; yukseklik tamamen genislikten turuyor. Tam genislikte
     16:9 bir banner genis ekranlarda viewport'tan uzun kaliyor ve alt kenar
     fold'un altinda kaliyordu (olcum: 1920x960'ta 1081px, 120px tasma).

     Genisligi, 16:9 yuksekligi kalan viewport yuksekligini asmayacak
     sekilde sinirliyoruz. --header-group-height duyuru cubugu dahil gercek
     header yuksekligi; header.js body uzerinde guncelliyor, JS oncesi tema
     varsayilani 60px.

     Mobilde banner zaten kisa oldugu icin sinir devreye girmez. */
  .slideshow-section--fit slideshow-component {
    /* width:100% sart: bilesen grid/flex icinde shrink-to-fit davraniyor ve
       icerigi yatay kaydirici oldugu icin dogal genisligi yok; yalnizca
       max-width verildiginde genislik 0'a cokuyor. */
    width: 100%;
    max-width: calc((100svh - var(--header-group-height, 60px)) * 16 / 9);
    margin-inline: auto;
  }

  @supports not (height: 100svh) {
    .slideshow-section--fit slideshow-component {
      max-width: calc((100vh - var(--header-group-height, 60px)) * 16 / 9);
    }
  }

  .slideshow-section {
    slideshow-arrows .slideshow-control:first-of-type {
      margin-inline-start: var(--padding-xs);
    }

    slideshow-arrows .slideshow-control:last-of-type {
      margin-inline-end: var(--padding-xs);
    }

    .slideshow--with-hints--mobile-with-hints {
      gap: var(--slideshow-gap, 0);
      grid-column: 1 / -1;
    }

    /* Hide navigation arrows at boundaries for with-hints mode */
    .slideshow--with-hints--mobile-with-hints slideshow-arrows .slideshow-control {
      transition: opacity 0.3s ease;
    }

    /* Override animation for boundary arrows in with-hints mode on hover */
    slideshow-component.slideshow--with-hints--mobile-with-hints:has(
        slideshow-slide:first-child:not([aria-hidden='true'])
      )
      > slideshow-container
      > slideshow-arrows
      .slideshow-control--previous,
    slideshow-component.slideshow--with-hints--mobile-with-hints:has(
        slideshow-slide:last-child:not([aria-hidden='true'])
      )
      > slideshow-container
      > slideshow-arrows
      .slideshow-control--next {
      animation: none;
      opacity: 0;
      pointer-events: none;
    }

    @media screen and (max-width: 749px) {
      .slideshow--with-hints--mobile-with-hints slideshow-slides {
        padding-inline: var(--page-margin);
      }

      .slideshow--with-hints--mobile-with-hints slideshow-slide {
        width: 96%;
      }

      .slideshow--with-hints--mobile-with-hints slideshow-slides {
        gap: min(var(--slideshow-gap, 0), 10px);
      }
    }

    @media screen and (min-width: 750px) {
      .slideshow--with-hints {
        gap: var(--slideshow-gap, 0);
        grid-column: 1 / -1;
      }

      .slideshow--with-hints slideshow-slides {
        padding-inline: var(--page-margin);
        gap: var(--slideshow-gap, 0);
      }

      .slideshow--with-hints slideshow-slide {
        width: calc((100vw - var(--page-margin) * 2));
        overflow: hidden;
      }

      .slideshow--with-hints slideshow-arrows .slideshow-control {
        transition: opacity 0.3s ease;
      }

      slideshow-component.slideshow--with-hints:has(slideshow-slide:first-child:not([aria-hidden='true']))
        > slideshow-container
        > slideshow-arrows
        .slideshow-control--previous,
      slideshow-component.slideshow--with-hints:has(slideshow-slide:last-child:not([aria-hidden='true']))
        > slideshow-container
        > slideshow-arrows
        .slideshow-control--next {
        animation: none;
        opacity: 0;
        pointer-events: none;
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
