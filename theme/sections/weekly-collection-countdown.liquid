      "default": "2.250 TL DEĞERİNDE 2. STRAP HEDİYE"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Açıklama",
      "default": "<p>Bugün strapli çantalarda 2. strap hediyenizi seçmeyi unutmayın. Kampanya sınırlı süre geçerlidir.</p>"
    },
    {
      "type": "text",
      "id": "end_label",
      "label": "Sayaç üstü metin",
      "default": "BUGÜN BİTİYOR"
    },
    {
      "type": "text",
      "id": "hours_label",
      "label": "Saat etiketi",
      "default": "SAAT"
    },
    {
      "type": "text",
      "id": "minutes_label",
      "label": "Dakika etiketi",
