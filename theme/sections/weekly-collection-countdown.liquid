      "default": "#2F8B3A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Metin rengi",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "timer_background",
      "label": "Sayaç kutusu",
      "default": "#090909"
    },
    {
      "type": "color",
      "id": "timer_text_color",
