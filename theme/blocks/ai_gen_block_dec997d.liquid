{% doc %}
  @prompt
    kayan yazı ekler misin , iki cümle yazacak yer olsun, ve hızını ayarlayabilelim,
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-marquee-container-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.padding_vertical }}px 0;
    display: block;
  }

  .ai-marquee-wrapper-{{ ai_gen_id }} {
    display: flex;
    width: fit-content;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.speed }}s linear infinite;
  }

  .ai-marquee-content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .ai-marquee-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.font_size }}px;
    margin: 0 {{ block.settings.spacing }}px;
  }

  .ai-marquee-separator-{{ ai_gen_id }} {
    color: {{ block.settings.separator_color }};
    font-size: {{ block.settings.font_size }}px;
    margin: 0 {{ block.settings.spacing }}px;
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .ai-marquee-container-{{ ai_gen_id }}:hover .ai-marquee-wrapper-{{ ai_gen_id }} {
    {% if block.settings.pause_on_hover %}
      animation-play-state: paused;
    {% endif %}
  }
{% endstyle %}

<marquee-text-{{ ai_gen_id }}
  class="ai-marquee-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-marquee-wrapper-{{ ai_gen_id }}">
    <div class="ai-marquee-content-{{ ai_gen_id }}">
      {% if block.settings.text_1 != blank %}
        <span class="ai-marquee-text-{{ ai_gen_id }}">{{ block.settings.text_1 }}</span>
      {% endif %}
      {% if block.settings.separator != blank %}
        <span class="ai-marquee-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
      {% endif %}
      {% if block.settings.text_2 != blank %}
        <span class="ai-marquee-text-{{ ai_gen_id }}">{{ block.settings.text_2 }}</span>
      {% endif %}
      {% if block.settings.separator != blank %}
        <span class="ai-marquee-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
      {% endif %}
    </div>
    <div class="ai-marquee-content-{{ ai_gen_id }}">
      {% if block.settings.text_1 != blank %}
        <span class="ai-marquee-text-{{ ai_gen_id }}">{{ block.settings.text_1 }}</span>
      {% endif %}
      {% if block.settings.separator != blank %}
        <span class="ai-marquee-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
      {% endif %}
      {% if block.settings.text_2 != blank %}
        <span class="ai-marquee-text-{{ ai_gen_id }}">{{ block.settings.text_2 }}</span>
      {% endif %}
      {% if block.settings.separator != blank %}
        <span class="ai-marquee-separator-{{ ai_gen_id }}">{{ block.settings.separator }}</span>
      {% endif %}
    </div>
  </div>
</marquee-text-{{ ai_gen_id }}>

<script>
  (function() {
    class MarqueeText{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.adjustSpeed();
      }

      adjustSpeed() {
        const wrapper = this.querySelector('.ai-marquee-wrapper-{{ ai_gen_id }}');
        if (wrapper) {
          const contentWidth = wrapper.scrollWidth / 2;
          wrapper.style.setProperty('--content-width', `${contentWidth}px`);
        }
      }
    }

    customElements.define('marquee-text-{{ ai_gen_id }}', MarqueeText{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Kayan yazı",
  "settings": [
    {
      "type": "header",
      "content": "İçerik"
    },
    {
      "type": "text",
      "id": "text_1",
      "label": "Birinci metin",
      "default": "Hoş geldiniz"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "İkinci metin",
      "default": "Yeni koleksiyonumuzu keşfedin"
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Ayırıcı",
      "default": "•"
    },
    {
      "type": "header",
      "content": "Stil"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Yazı boyutu",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Metin aralığı",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Dikey boşluk",
      "min": 5,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Arka plan rengi",
      "default": "#030302"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Metin rengi",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Ayırıcı rengi",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Animasyon"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Hız",
      "min": 5,
      "max": 50,
      "step": 5,
      "unit": "s",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Üzerine gelindiğinde durdur",
      "default": false
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Masaüstü genişlik",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Kayan yazı"
    }
  ]
}
{% endschema %}
