{% comment %}FUDA Oxford ColorPuff hediye varyant kartı{% endcomment %}
{% liquid
  assign gift_media = variant.featured_media | default: product.featured_media
  assign gift_title = product.title
  assign variant_title = variant.title
  assign has_variant_title = true
  if variant_title == blank or variant_title == 'Default Title'
    assign has_variant_title = false
  endif
%}
<article class="fuda-bundle-card" role="listitem" data-fuda-bundle-card data-product-id="{{ product.id }}" data-variant-id="{{ variant.id }}">
  <a class="fuda-bundle-card__link" href="{{ product.url }}?variant={{ variant.id }}">
    <div class="fuda-bundle-card__media">
      {% if gift_media != blank %}
        {{ gift_media.preview_image | image_url: width: 420 | image_tag: loading: 'lazy', widths: '160, 240, 320, 420', sizes: '(max-width: 749px) 42vw, 180px', class: 'fuda-bundle-card__image', alt: gift_media.alt | default: gift_title }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'fuda-bundle-card__placeholder' }}
      {% endif %}
    </div>
    <div class="fuda-bundle-card__body">
      {% if show_collection_name %}<span class="fuda-bundle-card__collection">ColorPuff Hediye</span>{% endif %}
      <span class="fuda-bundle-card__title">{{ gift_title }}</span>
      {% if has_variant_title %}<span class="fuda-bundle-card__variant">{{ variant_title }}</span>{% endif %}
      {% if show_price %}
        <span class="fuda-bundle-card__price">
          <strong>{{ variant.price | money }}</strong>
          {% if variant.compare_at_price > variant.price %}<s>{{ variant.compare_at_price | money }}</s>{% endif %}
        </span>
      {% endif %}
    </div>
  </a>
</article>
