# Bu dosyayi .env olarak kopyala. .env gitignore'dadir.
SHOPIFY_STORE=uy2rpe-ni.myshopify.com

# --- Kimlik dogrulama ---
#
# YOL 1 (tercih edilen): client_credentials grant.
# Script bu ikisinden 24 saatlik bir Admin API access token uretir,
# .shopify-token.json icinde onbellekler ve suresi dolunca yeniler.
# Ikisi de: Shopify Admin > Settings > Apps and sales channels
#   > Develop apps > [app] > API credentials
# Gerekli scope'lar: read_themes, write_themes
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# YOL 2: elde hazir bir kalici token varsa (eski admin-created custom app'ler).
# SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# YOL 3: token'i cloud environment'in "API credentials" bolumunde tut.
# Agent proxy header'i istek VM'den ciktiktan sonra ekler; token session
# icinde hic bulunmaz.
#   Allowed websites : uy2rpe-ni.myshopify.com
#   Custom header    : X-Shopify-Access-Token  (prefix alanini BOS birak)
# SHOPIFY_PROXY_AUTH=1

# Opsiyonel
SHOPIFY_API_VERSION=2026-07
