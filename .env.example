# Bu dosyayi .env olarak kopyala ve doldur. .env gitignore'da.
SHOPIFY_STORE=uy2rpe-ni.myshopify.com

# Admin Api access token - "shpat_" ile baslar.
# Shopify Admin > Settings > Apps and sales channels > Develop apps
#   > [app] > API credentials > Admin API access token
# Gerekli scope'lar: read_themes, write_themes
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opsiyonel
SHOPIFY_API_VERSION=2025-07
